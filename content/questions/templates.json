    "prompt": "Pada barisan aritmetika, <b>U<sub>{p}</sub> = {up}</b> dan <b>U<sub>{q}</sub> = {uq}</b>. Tentukan b dan a.",
    "fields": [
      { "key": "b", "label": "b =", "answer": "b", "chip": "b", "misconceptions": ["M8"] },
      { "key": "a", "label": "a =", "answer": "a", "chip": "a", "misconceptions": ["M8"] }
    ],
    "hints": [
      "Dari U<sub>{p}</sub> ke U<sub>{q}</sub> ada {q - p} lompatan.",
      "{q - p} × b = {uq} − {up|p} = {uq - up}.",
      "b = {uq - up} ÷ {q - p} = ▢. Lalu a = {up} − {p - 1} × b."
    ],
    "solution": [
      "Lompatan: {q} − {p} = {q - p}",
      "{q - p}b = {uq} − {up|p} = {uq - up}, jadi <b>b = {b}</b>",
      "U<sub>{p}</sub> = a + {p - 1}b → {up} = a + {(p - 1) * b|p}",
      "<b>a = {a}</b>"
